# The browser app calls the backend through the same Vercel origin (/api).
# Leave this unset for the normal production deployment.
# NEXT_PUBLIC_API_URL=

# ─── Checkout payment recipient details ────────────────────────────────────
# These are shown to customers at checkout so they know where to send money.
# They are NOT secrets (NEXT_PUBLIC_* is fine here) but they ARE real payment
# credentials — never commit real values to source. A method whose variables
# are left unset is simply hidden from the checkout page instead of falling
# back to a placeholder.
#
# CIH Bank transfer — all four required together, or the method is hidden:
NEXT_PUBLIC_CIH_HOLDER=
NEXT_PUBLIC_CIH_RIB=
NEXT_PUBLIC_CIH_IBAN=
NEXT_PUBLIC_CIH_SWIFT=
# PayPal — the email/handle customers should send to:
NEXT_PUBLIC_PAYPAL_ME=
# TapTapSend — the phone number customers should send to:
NEXT_PUBLIC_TAPTAP_PHONE=
