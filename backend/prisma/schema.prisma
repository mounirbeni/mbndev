generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("client")   // "admin" | "client"
  plan      String   @default("custom")   // "starter" | "pro" | "premium" | "custom"
  avatar    String   @default("")
  company   String   @default("")
  phone     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]      @relation("ClientProjects")
  orders         Order[]
  messages       Message[]
  payments       Payment[]
  uploadedFiles  ProjectFile[]
  readMessages   MessageRead[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  resetTokens    PasswordResetToken[]
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the random token sent via email — never stores the plaintext
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id           String   @id @default(cuid())
  clientId     String
  client       User     @relation(fields: [clientId], references: [id])
  serviceType  String   // website | ecommerce | dashboard | mobile | custom
  title        String
  description  String?
  pages        Int      @default(5)
  features     String[]
  addons       String[]
  totalPrice   Float
  deliveryDays Int      @default(14)
  notes        String?
  status       String   @default("pending") // pending | paid | cancelled
  designStyle  String?
  designColors String[]
  designRefs   String[]
  // Linked project — set after payment completes
  project      Project?
  payments     Payment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  clientId     String
  client       User          @relation("ClientProjects", fields: [clientId], references: [id])
  // Link back to the order that created this project
  orderId      String?       @unique
  order        Order?        @relation(fields: [orderId], references: [id])
  type         String        @default("custom")   // landing-page | ecommerce | saas | portfolio | web-app | custom
  status       String        @default("pending")  // pending | paid | in-progress | review | revision | completed | cancelled
  progress     Int           @default(0)
  budget       Float
  deadline     DateTime?
  features     String[]
  package      String        @default("custom")   // starter | pro | premium | custom
  notes        String?
  revisions    Int           @default(0)
  maxRevisions Int           @default(3)
  // Design preferences (flattened)
  designStyle  String?
  designColors String[]
  designRefs   String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  milestones   Milestone[]
  files        ProjectFile[]
  messages     Message[]
  payments     Payment[]
  activityLogs ActivityLog[]
}

// ─── Milestones ───────────────────────────────────────────────────────────────

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  status      String    @default("pending")  // "pending" | "paid"
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

// ─── Project Files ────────────────────────────────────────────────────────────

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  url          String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String?                                      // null = system message
  sender    User?         @relation(fields: [senderId], references: [id])
  content   String
  type      String        @default("user")              // "user" | "system"
  isRead    Boolean       @default(false)
  readBy    MessageRead[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId, createdAt])
  @@index([isRead, senderId])
}

model MessageRead {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                    String    @id @default(cuid())
  // projectId is nullable — set after project is auto-created following payment
  projectId             String?
  project               Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // orderId links to the Order being paid
  orderId               String?
  order                 Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clientId              String
  client                User      @relation(fields: [clientId], references: [id])
  amount                Float
  currency              String    @default("usd")
  status                String    @default("pending")  // pending | pending_verification | paid | failed | refunded
  milestoneTitle        String?
  description           String?
  method                String?   // cih_bank | paypal | taptapsend | mock
  // External transaction reference (PayPal txn ID, bank ref, etc) — proof of payment
  externalRef           String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ─── Packages (Pricing) ───────────────────────────────────────────────────────

model Package {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  price        Float
  description  String?
  features     String[]
  pages        Int?
  revisions    Int?
  deliveryDays Int?
  originalPrice Float?
  badge        String?
  popular      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // order_placed | payment_received | project_created | status_update | new_message | revision_request | project_delivered
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())
}

// ─── Activity Logs ────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // status_change | file_upload | message_sent | payment_received | milestone_updated | revision_requested | project_delivered
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
}
