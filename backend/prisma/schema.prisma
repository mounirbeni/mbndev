generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("client")   // "admin" | "client"
  plan      String   @default("custom")   // "starter" | "pro" | "premium" | "custom"
  avatar    String   @default("")
  company   String   @default("")
  phone     String?  @unique                // nullable; unique enforced on non-null values
  locale    String   @default("en")
  isActive              Boolean   @default(true)
  deletionRequestedAt   DateTime?
  adminNotes            String?                  // set when client requests account deletion — pending admin approval
  passwordChangedAt     DateTime?                  // set on every password mutation — used to invalidate old JWTs
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  projects       Project[]      @relation("ClientProjects")
  orders         Order[]
  messages       Message[]
  payments       Payment[]
  uploadedFiles  ProjectFile[]
  readMessages   MessageRead[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  resetTokens    PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  leadsAiAccount LeadsAiAccount?
  prospects      Prospect[]
  localGrowthAccount LocalGrowthAccount?
  localGrowthReports LocalGrowthReport[]
  supportAiAccount   SupportAiAccount?
  supportBots        SupportBot[]
  reviewBoosterAccount ReviewBoosterAccount?
  reviewBusinesses     ReviewBusiness[]
  proposalAccount      ProposalAccount?
  proposals            Proposal[]

  @@index([email])
  @@index([role, isActive])
  @@index([createdAt])
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the random token sent via email — never stores the plaintext
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id           String   @id @default(cuid())
  clientId     String
  // Restrict (explicit, matches the prior default) is relied on directly by
  // deleteUserCascade (routes/admin.js) — it deletes a client's Orders
  // BEFORE the User row precisely because this relation blocks the delete
  // otherwise. Change this and update that function together.
  client       User     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceType  String   // website | ecommerce | dashboard | mobile | custom
  title        String
  description  String?
  pages        Int      @default(5)
  features     String[]
  addons       String[]
  totalPrice   Float
  deliveryDays Int      @default(14)
  notes        String?
  status       String   @default("pending") // pending | paid | cancelled
  // The plan (starter | pro | premium | custom) totalPrice was calculated
  // under at creation time. Nullable because existing orders predate this
  // column; null means "no plan discount applied" (the pre-existing
  // behavior), never "recalculate under the client's current plan".
  plan         String?
  // Personal offer (lib/offers.js) applied at creation, as a percentage.
  // Null = no offer. Re-applied when a pending order is edited.
  discountPct  Int?
  // Software product orders ("leads-ai:pro"): paying activates the product
  // instead of creating a Project. Null for every project order.
  product      String?
  designStyle  String?
  designColors String[]
  designRefs   String[]
  // Linked project — set after payment completes
  project      Project?
  payments     Payment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  clientId     String
  // Restrict (explicit, matches the prior default) — deleteUserCascade
  // (routes/admin.js) deletes each of a client's Projects individually
  // BEFORE the User row precisely because this relation blocks the delete
  // otherwise (that per-project delete is also what cascades Milestones,
  // Messages, MessageReads, ProjectFiles and ActivityLogs for it).
  client       User          @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  // Link back to the order that created this project
  orderId      String?       @unique
  order        Order?        @relation(fields: [orderId], references: [id])
  type         String        @default("custom")   // landing-page | ecommerce | saas | portfolio | web-app | custom
  status       String        @default("pending")  // pending | paid | in-progress | review | revision | completed | cancelled
  progress     Int           @default(0)
  budget       Float
  deadline     DateTime?
  features     String[]
  package      String        @default("custom")   // starter | pro | premium | custom
  notes        String?
  revisions    Int           @default(0)
  maxRevisions Int           @default(3)
  // Design preferences (flattened)
  designStyle  String?
  designColors String[]
  designRefs   String[]
  // Bumped to invalidate every previously issued share link for this
  // project at once (see generateShareToken/getProjectByShareToken) — the
  // share token is a stateless JWT with no per-token record, so this is
  // what makes a link individually revocable instead of just expiring
  // naturally after 90 days.
  shareTokenVersion Int      @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  milestones   Milestone[]
  files        ProjectFile[]
  messages     Message[]
  payments     Payment[]
  activityLogs ActivityLog[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

// ─── Milestones ───────────────────────────────────────────────────────────────

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  status      String    @default("pending")  // "pending" | "paid"
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

// ─── Project Files ────────────────────────────────────────────────────────────

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  url          String
  uploadedById String
  // Restrict (explicit) — deleteUserCascade deletes a user's cross-project
  // uploads (files they uploaded to OTHER clients' projects) explicitly
  // before deleting the User, since this relation blocks it otherwise.
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt   DateTime @default(now())

  @@index([projectId])
  @@index([uploadedById])
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String?                                      // null = system message
  sender    User?         @relation(fields: [senderId], references: [id])
  content   String
  type      String        @default("user")              // "user" | "system"
  isRead    Boolean       @default(false)
  readBy    MessageRead[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId, createdAt])
  @@index([isRead, senderId])
}

model MessageRead {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  // Restrict (explicit) — deleteUserCascade explicitly clears a user's
  // MessageRead rows (their reads of OTHER clients'/projects' messages)
  // before deleting the User, since this relation blocks it otherwise.
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([messageId, userId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                    String    @id @default(cuid())
  // projectId is nullable — set after project is auto-created following payment
  projectId             String?
  project               Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // orderId links to the Order being paid
  orderId               String?
  order                 Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clientId              String
  // Restrict (explicit, matches the prior default) — deleteUserCascade
  // deletes a client's Payments BEFORE the User row precisely because this
  // relation blocks the delete otherwise. Financial records must never be
  // silently cascaded away — deleting the User first would either fail
  // loudly (good) or, if this were ever changed to Cascade, destroy payment
  // history (bad). Change this and update that function together.
  client                User      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  amount                Float
  currency              String    @default("usd")
  status                String    @default("pending")  // pending | pending_verification | processing | paid | failed | refunded
  milestoneTitle        String?
  description           String?
  method                String?   // cih_bank | paypal | taptapsend | mock
  // External transaction reference (PayPal txn ID, bank ref, etc) — proof of payment
  externalRef           String?
  rejectionReason       String?   // set by admin on reject — shown to client
  // ── Hardening fields ─────────────────────────────────────────────────────
  snapshotAmount        Float?    // amount locked at submission (tamper-proof copy of order.totalPrice)
  expiresAt             DateTime? // pending_verification auto-expires at this time (72 h)
  flaggedReason         String?   // set by fraud detection — admin sees this
  riskScore             Int?      // 0–100 computed at submission; ≥ 60 = auto-flagged
  ipAddress             String?   // submitter IP (forensic tracing)
  // Client-generated key — prevents double-submit. NOTE: environments that
  // ran migrate6.js (e.g. production, before this column existed in
  // schema.prisma) actually have a PARTIAL unique index —
  // `CREATE UNIQUE INDEX ... WHERE "idempotencyKey" IS NOT NULL` — while a
  // fresh `prisma db push` on a blank DB creates a plain, non-partial
  // unique index for this `@unique` attribute instead. Verified these
  // don't functionally differ (Postgres already treats NULLs as distinct
  // under a plain unique index, so both allow unlimited NULL rows while
  // enforcing uniqueness on non-null values identically) and that `db
  // push` does NOT try to reconcile the difference — it treats the partial
  // index as already satisfying this constraint and reports no drift. See
  // migrate6.js for the historical partial-index version.
  idempotencyKey        String?   @unique
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  events                PaymentEvent[]

  @@index([clientId, status])
  @@index([status, createdAt])
  @@index([externalRef])         // fast duplicate-ref look-up
  @@index([idempotencyKey])
  @@index([expiresAt])           // reconciliation queries
}

// ─── Payment Event Log (immutable append-only) ────────────────────────────────
// Every status change is recorded here forever. Rows are never updated or deleted.

model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Intentionally NOT a @relation to User, despite always being populated
  // from req.user.id today: this is an immutable financial audit trail and
  // must keep showing "who did this" even after that user account is
  // deleted (deleteUserCascade never touches PaymentEvent rows) — a real FK
  // would force onDelete: SetNull/Cascade and silently erase or null out
  // that history. actorId is left unenforced by design; never add a
  // relation here without also deciding what happens to these rows on user
  // deletion.
  actorId    String?  // null = automated system action
  actorRole  String?  // 'admin' | 'client' | 'system'
  event      String   // created | submitted | approved | rejected | expired | rolled_back | flagged | refunded
  fromStatus String?
  toStatus   String
  note       String?  // rejection reason, fraud flag reason, etc.
  metadata   Json?    // extra forensic data (IP, userAgent, amount, method, riskScore, flags)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([event])
  @@index([actorId])
}

// ─── Admin Audit Log ──────────────────────────────────────────────────────────
// Every destructive or sensitive admin action is recorded immutably.

model AdminAuditLog {
  id         String   @id @default(cuid())
  // Intentionally NOT a @relation to User, for two reasons: (1) same
  // survive-user-deletion rationale as PaymentEvent.actorId above — this is
  // an immutable audit trail, not live application state; (2) jobs/
  // reconcile.js writes the literal sentinel string 'system' here for
  // automated actions (see logAdminAction({ adminId: 'system', ... })),
  // which is not a real User.id and would violate a real FK constraint on
  // every reconciliation run. Never add a relation here without first
  // giving system-initiated rows a real actor representation.
  adminId    String
  action     String   // approve_payment | reject_payment | delete_client | toggle_client | mock_payment | reconcile
  targetType String   // payment | order | project | user
  targetId   String
  before     Json?    // snapshot of key fields before the change
  after      Json?    // snapshot after
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ─── Packages (Pricing) ───────────────────────────────────────────────────────

// Marketing/display content for the public pricing page ONLY — see
// controllers/packageController.js. Never consulted by lib/pricing.js's
// calculatePrice(), which is the sole source of truth for order pricing.
model Package {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  price        Float
  description  String?
  features     String[]
  pages        Int?
  revisions    Int?
  deliveryDays Int?
  originalPrice Float?
  badge        String?
  popular      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // order_placed | payment_received | project_created | status_update | new_message | revision_request | project_delivered
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Login Attempts (brute-force protection) ──────────────────────────────────

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String                          // normalised (lowercase)
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ─── Leads (outreach CRM) ────────────────────────────────────────────────────

model Lead {
  id             String    @id @default(cuid())
  name           String
  type           String                              // riad | restaurant | boutique | tour_guide
  city           String
  phone          String?
  email          String?
  instagram      String?
  website        String?                             // none | basic | yes
  priority       String    @default("warm")          // hot | warm
  outreachAngle  String?
  source         String?
  status         String    @default("new")           // new | emailed | dm_sent | replied | converted | not_interested
  notes          String?
  emailSentAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, priority])
  @@index([type])
}

// ─── Activity Logs ────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  // Restrict (explicit) — deleteUserCascade explicitly clears logs where
  // this user is the actor (which can span OTHER clients' projects, e.g. an
  // admin's actions) before deleting the User, since this relation blocks
  // it otherwise.
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action      String   // status_change | file_upload | message_sent | payment_received | milestone_updated | revision_requested | project_delivered
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

// ─── MBN Leads AI (product) ─────────────────────────────────────────────────
// One row per buyer: plan, usage counter and their own API keys (encrypted
// with lib/leadsAi/crypto.js — never stored or returned in plain text).
model LeadsAiAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String   @default("starter") // starter | pro | agency
  searchMonth    String   @default("")        // "2026-10" — resets searchCount
  searchCount    Int      @default(0)
  googleKeyEnc   String?
  openaiKeyEnc   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A business the buyer saved from a search, with its website audit.
model Prospect {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  name      String
  address   String?
  phone     String?
  website   String?
  email     String?
  rating    Float?
  reviews   Int?
  mapsUrl   String?
  query     String?
  score     Int      @default(0)
  audit     Json?
  message   String?
  status    String   @default("new")   // new | contacted | replied | won | lost
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, placeId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

// ─── MBN Local Growth (product) ─────────────────────────────────────────────
// Same shape as LeadsAiAccount, plus the agency branding shown on reports.
model LocalGrowthAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String   @default("starter") // starter | pro | agency
  reportMonth  String   @default("")
  reportCount  Int      @default(0)
  googleKeyEnc String?
  openaiKeyEnc String?
  brandName    String?                       // agency plan: "Prepared by …"
  brandUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One generated growth report. `data` holds the full report snapshot so it
// renders the same forever, even if the business changes later.
model LocalGrowthReport {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId    String
  name       String
  address    String?
  score      Int
  data       Json
  shareToken String   @unique
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── MBN Support AI (product) ───────────────────────────────────────────────
model SupportAiAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String   @default("starter") // starter | pro | agency
  messageMonth  String   @default("")
  messageCount  Int      @default(0)
  openaiKeyEnc  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One chat assistant, trained on one website.
model SupportBot {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  websiteUrl      String
  welcome         String   @default("Hi! How can I help you today?")
  color           String   @default("#7c3aed")
  allowedDomains  String[]
  handoffWhatsapp String?
  handoffEmail    String?
  notes           String?  // owner-written FAQ / facts, always given to the AI
  active          Boolean  @default(true)
  pageCount       Int      @default(0)
  trainedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  chunks          SupportChunk[]
  conversations   SupportConversation[]
  leads           SupportLead[]

  @@index([userId])
}

model SupportChunk {
  id    String     @id @default(cuid())
  botId String
  bot   SupportBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  url   String
  title String?
  text  String

  @@index([botId])
}

model SupportConversation {
  id        String     @id @default(cuid())
  botId     String
  bot       SupportBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  visitorId String
  messages  Json       // [{ role: 'user'|'assistant', content, at }]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([botId, updatedAt])
}

model SupportLead {
  id             String     @id @default(cuid())
  botId          String
  bot            SupportBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversationId String?
  name           String?
  email          String?
  phone          String?
  message        String?
  createdAt      DateTime   @default(now())

  @@index([botId, createdAt])
}

// ─── MBN Review Booster (product) ───────────────────────────────────────────

model ReviewBoosterAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String   @default("starter") // starter | pro | agency
  googleKeyEnc String?
  openaiKeyEnc String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReviewBusiness {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  googleReviewUrl String
  color           String           @default("#7c3aed")
  language        String           @default("en") // en | fr | ar | es
  active          Boolean          @default(true)
  views           Int              @default(0)
  googleClicks    Int              @default(0)
  requestsSent    Int              @default(0)
  // Google monitoring (Places API, owner's key)
  placeId         String?
  rating          Float?
  ratingCount     Int?
  monitoredAt     DateTime?
  monitorError    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  feedback        ReviewFeedback[]
  googleReviews   GoogleReview[]
  snapshots       ReviewSnapshot[]

  @@index([userId])
}

model ReviewFeedback {
  id         String         @id @default(cuid())
  businessId String
  business   ReviewBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating     Int?
  message    String
  name       String?
  contact    String?
  createdAt  DateTime       @default(now())

  @@index([businessId, createdAt])
}

/// A Google review seen while monitoring (Google returns up to 5 per check).
model GoogleReview {
  id          String         @id @default(cuid())
  businessId  String
  business    ReviewBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleId    String
  author      String?
  rating      Int
  text        String?
  language    String?
  publishedAt DateTime?
  replyDraft  String?
  createdAt   DateTime       @default(now())

  @@unique([businessId, googleId])
  @@index([businessId, publishedAt])
}

/// Rating and review count at each monitoring check — the trend line.
model ReviewSnapshot {
  id          String         @id @default(cuid())
  businessId  String
  business    ReviewBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating      Float?
  ratingCount Int
  createdAt   DateTime       @default(now())

  @@index([businessId, createdAt])
}

// ─── MBN Proposal AI (product) ──────────────────────────────────────────────

model ProposalAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String   @default("starter") // starter | pro | agency
  proposalMonth String   @default("")
  proposalCount Int      @default(0)
  openaiKeyEnc  String?
  brandName     String?
  brandColor    String   @default("#7c3aed")
  brandEmail    String?
  brandWebsite  String?
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Proposal {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  clientName     String
  clientCompany  String?
  clientEmail    String?
  clientPhone    String?
  language       String    @default("en") // en | fr | ar | es
  currency       String    @default("USD")
  content        Json      // { intro, solution, phases[], terms }
  items          Json      // [{ id, name, description, price, optional }]
  status         String    @default("draft") // draft | sent | viewed | accepted | declined
  isTemplate     Boolean   @default(false)
  shareToken     String    @unique
  validUntil     DateTime?
  viewCount      Int       @default(0)
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  sentAt         DateTime?
  followUpSentAt DateTime?
  acceptedAt     DateTime?
  acceptedName   String?
  acceptedItems  Json?
  acceptedTotal  Float?
  declinedAt     DateTime?
  declineReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@index([status, sentAt])
}

// ─── Careers: job applications from /careers ────────────────────────────────

model JobApplication {
  id              String   @id @default(cuid())
  role            String   // role slug from lib/careers.js, or 'open'
  fullName        String
  email           String
  phone           String?
  location        String?
  experienceYears String   // '<1' | '1-2' | '3-5' | '5+'
  availability    String   // 'now' | '2-weeks' | '1-month' | 'later'
  weeklyHours     String?
  expectedRate    String?
  portfolioUrl    String?
  linkedinUrl     String?
  languages       String[]
  answers         Json     // role-specific answers { questionKey: value }
  message         String?
  cvUrl           String
  cvName          String
  cvSize          Int
  status          String   @default("new") // new | reviewing | shortlisted | rejected | hired
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([role, createdAt])
}
