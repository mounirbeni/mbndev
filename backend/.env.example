# ─── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────
# Neon PostgreSQL — both sslmode=require and channel_binding=require
# IMPORTANT for production: use Neon's POOLED connection string (the one
# with "-pooler" in the hostname), not the direct one. lib/prisma.js caps
# each serverless instance to a small connection pool specifically so many
# concurrent instances don't exhaust Neon's connection limit — that only
# holds up if the underlying endpoint is itself pooled (PgBouncer). Under
# real concurrent load (many SSE streams, each holding an instance open for
# up to a minute — see vercel.json's maxDuration), the direct endpoint can
# still be exhausted even with a small per-instance pool.
DATABASE_URL=postgresql://user:password@host-pooler:5432/mbndev?sslmode=require&channel_binding=require

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
# Keep this SHORT — the app pairs a short-lived access token with a 30-day
# httpOnly refresh token, precisely so a leaked access token expires fast.
# Setting this to days/weeks defeats that design.
JWT_EXPIRE=15m
# Separate secret for refresh tokens — keeps the two token types
# cryptographically independent so one secret leaking doesn't forge the other.
# Generate the same way as JWT_SECRET.
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string

# ─── CORS ──────────────────────────────────────────────────────────────────
# Production frontend origin (the deployed Next.js URL)
CLIENT_URL=https://mbndev.com
# Comma-separated list of allowed Vercel preview-domain SUFFIXES
# e.g. -mbndev.vercel.app  (matches feature-branch-mbndev.vercel.app)
ALLOWED_VERCEL_DOMAINS=

# ─── Email (Brevo) ─────────────────────────────────────────────────────────
# Get an API key at https://www.brevo.com — used for password reset, order
# confirmations, and admin verification emails. Without this set, emails
# are no-op'd (logged to stdout) and the app continues to work.
BREVO_API_KEY=
# Verified sender — must be a domain you control in Brevo.
EMAIL_FROM=MBN DEV <contact@mbndev.ma>
# Where admin alerts (new payment, etc.) get sent
ADMIN_EMAIL=admin@mbndev.com

# ─── File storage (Vercel Blob) ────────────────────────────────────────────
# REQUIRED in production: without it uploads land in /tmp and are LOST when
# the serverless instance recycles. Create a Blob store in the Vercel
# dashboard (Storage → Blob) and link it to the project — Vercel injects
# this token automatically. Local dev works without it (files in backend/uploads).
BLOB_READ_WRITE_TOKEN=

# ─── Realtime fan-out (Redis, optional) ────────────────────────────────────
# Recommended in production: SSE connections live in per-instance memory, so
# without Redis an event published by one serverless instance never reaches
# clients connected to another. Any Redis works — Upstash free tier is fine.
# e.g. rediss://default:password@host:6379
REDIS_URL=

# ─── Telegram notifications (optional, admin alerts) ───────────────────────
# Free, real-time push to an admin's phone/desktop for new orders, new
# clients, payment events, and new client messages (see lib/telegram.js).
# Without both set, notifications are just logged to stdout — the app
# continues to work normally.
# Create a bot via @BotFather on Telegram to get a token; message the bot
# once, then fetch https://api.telegram.org/bot<TOKEN>/getUpdates to find
# your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Database connection pool (optional) ───────────────────────────────────
# Overrides lib/prisma.js's per-instance connection pool size. Defaults are
# already tuned for the common cases (3 in production/serverless — kept
# small so many concurrent Vercel instances don't exhaust Neon's connection
# limit; 5 otherwise) — only set this if you've profiled an actual
# connection-exhaustion or under-utilization problem.
DB_POOL_SIZE=

# ─── Fraud detection (optional) ─────────────────────────────────────────────
# Comma-separated list of additional externalRef values (bank/PayPal
# reference numbers submitted as payment proof) to treat as obviously fake,
# on top of the built-in list in lib/paymentGuard.js (e.g. "test", "demo",
# "12345"). Matched case-insensitively. Use this to block new junk values
# you observe in production without a code deploy.
FRAUD_BLOCKED_REFS=

# ─── Payment reconciliation cron ────────────────────────────────────────────
# REQUIRED for the scheduled reconciler (vercel.json's `crons` block calling
# GET /api/payments/cron-reconcile) to run at all — without it that endpoint
# refuses every request. Vercel automatically sends this value as
# `Authorization: Bearer <CRON_SECRET>` on its own cron invocations once set.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: sub-daily cron schedules require a paid Vercel plan (Hobby is limited
# to once/day) — check your plan and adjust vercel.json's schedule if needed.
# The admin-triggered POST /api/payments/reconcile button works regardless
# and should be used as the primary recovery path on the Hobby plan.
CRON_SECRET=
